/*
 * =============================================================================
 * Include
 * =============================================================================
 *
 * LEDの色指定、ZMKのMatrix Transform、
 * Eyelash CorneのPhysical Layout定義を読み込む。
 */

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "eyelash_corne-layouts.dtsi"


/ {
    /*
     * =========================================================================
     * ZMK Chosen Devices
     * =========================================================================
     *
     * ZMKが使用する各ハードウェア定義を指定する。
     */

    chosen {
        /* キーマトリクスのスキャンにkscan0を使用する。 */
        zmk,kscan = &kscan0;

        /* バッテリー電圧取得にvbattを使用する。 */
        zmk,battery = &vbatt;

        /* RGB Underglowにled_stripを使用する。 */
        zmk,underglow = &led_strip;

        /* Key Backlightにbacklightを使用する。 */
        zmk,backlight = &backlight;

        /* キーボードのPhysical Layoutとしてdefault_layoutを使用する。 */
        zmk,physical-layout = &default_layout;
    };


    /*
     * =========================================================================
     * Battery
     * =========================================================================
     *
     * nRF52840のVDDHを利用してバッテリー電圧を取得する。
     */

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };


    /*
     * =========================================================================
     * External Power
     * =========================================================================
     *
     * 外部デバイスへの電源供給を制御する。
     *
     * Control GPIO：P0.13
     * Active：HIGH
     * 初期化待ち時間：50ms
     */

    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <50>;
    };


    /*
     * =========================================================================
     * Left Rotary Encoder
     * =========================================================================
     *
     * 左側EC11ロータリーエンコーダのハードウェア定義。
     *
     * A相：P1.10
     * B相：P1.14
     * GPIO Pull-upを使用。
     *
     * steps：40
     *
     * デフォルトではdisabled。
     * 必要な側のoverlay等から有効化して使用する。
     */

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "disabled";
    };


    /*
     * =========================================================================
     * Encoder Sensor
     * =========================================================================
     *
     * ZMKから使用するセンサーとしてleft_encoderを登録する。
     *
     * triggers-per-rotation：20
     * → 1回転あたり20回のZMK Sensorイベントとして扱う。
     */

    sensors {
        compatible = "zmk,keymap-sensors";
        triggers-per-rotation = <20>;
        sensors = <&left_encoder>;
    };


    /*
     * =========================================================================
     * Key Matrix Scan
     * =========================================================================
     *
     * GPIO Matrix方式でキースイッチをスキャンする。
     *
     * Diode Direction：Column → Row
     *
     * Row GPIO：
     *   Row 0 = P0.19
     *   Row 1 = P0.08
     *   Row 2 = P0.12
     *   Row 3 = P0.11
     *   Row 4 = P1.09
     *
     * Column GPIO：
     *   Col 0 = P0.03
     *   Col 1 = P0.28
     *   Col 2 = P0.30
     *   Col 3 = P0.21
     *   Col 4 = P0.23
     *   Col 5 = P0.22
     *   Col 6 = P0.29
     *
     * wakeup-source：
     * → Sleep中のキー入力をWake-up Sourceとして使用する。
     */

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 3 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            , <&gpio0 30 GPIO_ACTIVE_HIGH>
            , <&gpio0 21 GPIO_ACTIVE_HIGH>
            , <&gpio0 23 GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            ;
    };


    /*
     * =========================================================================
     * Matrix Transform
     * =========================================================================
     *
     * 物理キーマトリクス上のRow / Columnと、
     * ZMK Keymap上のキー位置を対応させる。
     *
     * Logical Matrix：
     *   Columns = 14
     *   Rows    = 5
     *
     * RC(row, column)で各キーの位置を指定する。
     *
     * 5-wayスイッチ等を含む特殊な配置も、
     * このTransformによってKeymap上の位置へ割り当てられる。
     *
     * ★ キー配列そのものに関係する重要な定義なので、
     *   ハードウェア構成を変更しない限り基本的に変更しない。
     */

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                      RC(0,12)           RC(0,13) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)             RC(2,12) RC(4,12) RC(3,12)  RC(1,13) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,2)              RC(1,12)           RC(2,13) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                    RC(3,3) RC(3,4) RC(3,5)                                         RC(3,13) RC(3,7) RC(3,8)
        >;
    };


    /*
     * =========================================================================
     * Key Backlight
     * =========================================================================
     *
     * PWMを使用してBacklightの明るさを制御する。
     *
     * PWM Controller：PWM0
     * Channel       ：0
     * Period        ：1ms
     * Polarity      ：Normal
     */

    backlight: pwmleds {
        compatible = "pwm-leds";

        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
        };
    };
};


/*
 * =============================================================================
 * Pin Control
 * =============================================================================
 *
 * SPI / PWMで使用するnRF52840のGPIOを定義する。
 *
 * default：
 *   通常動作時のPin設定
 *
 * sleep：
 *   Sleep時のPin設定
 *   low-power-enableによって低消費電力状態へ移行する。
 */

&pinctrl {

    /*
     * -------------------------------------------------------------------------
     * SPI0 - nice!view
     * -------------------------------------------------------------------------
     *
     * SCK  = P0.20
     * MOSI = P0.17
     * MISO = P0.25
     */

    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 25)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 25)>;

            low-power-enable;
        };
    };


    /*
     * -------------------------------------------------------------------------
     * PWM0 - Key Backlight
     * -------------------------------------------------------------------------
     *
     * PWM OUT0 = P1.13
     */

    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
            low-power-enable;
        };
    };


    /*
     * -------------------------------------------------------------------------
     * SPI3 - RGB Underglow
     * -------------------------------------------------------------------------
     *
     * MOSI = P1.12
     *
     * WS2812のデータ出力に使用する。
     */

    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 12)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 12)>;
            low-power-enable;
        };
    };
};


/*
 * =============================================================================
 * nice!view SPI
 * =============================================================================
 *
 * nice!viewディスプレイ用SPI0設定。
 *
 * SPI Controller：SPI0
 * CS GPIO       ：P0.06
 * CS Active     ：HIGH
 *
 * 通常時とSleep時で、それぞれ上記のpinctrl設定を使用する。
 */

nice_view_spi: &spi0 {
    compatible = "nordic,nrf-spim";

    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    cs-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
};


/*
 * =============================================================================
 * PWM0
 * =============================================================================
 *
 * Key Backlight用PWM Controllerを有効化する。
 */

&pwm0 {
    status = "okay";

    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 =<&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};


/*
 * =============================================================================
 * SPI3 / WS2812 RGB Underglow
 * =============================================================================
 *
 * SPI3を使用してWS2812 RGB LEDを制御する。
 *
 * LED数              ：21
 * SPI Clock          ：4MHz
 * Logic 1 Frame      ：0x70
 * Logic 0 Frame      ：0x40
 * Color Mapping      ：Green / Red / Blue
 *
 * ★ RGB Underglowのハードウェア定義。
 */

&spi3 {
    status = "okay";
    compatible = "nordic,nrf-spim";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <21>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <
            LED_COLOR_ID_GREEN
            LED_COLOR_ID_RED
            LED_COLOR_ID_BLUE
        >;
    };
};