#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors/naginata.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    macros {
        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RGUI &to 1>;
        };

        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LGUI &to 0>;
        };
    };

    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;

            label = "Shift";
        };

        mt_impl: mod-tap-by-hold-tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_BY_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        lt_impl: layer-tap-by-hold-tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BY_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    combos {
        compatible = "zmk,combos";

        Browse {
            bindings = <&to 5>;
            key-positions = <29 14>;
            layers = <0>;
        };

        Media {
            bindings = <&to 6>;
            key-positions = <30 15>;
            layers = <0>;
        };

        System {
            bindings = <&to 7>;
            key-positions = <40 26 11>;
            layers = <0>;
            timeout-ms = <300>;
        };

        Emo {
            bindings = <&kp LG(LC(SPACE))>;
            key-positions = <26 40>;
            layers = <0 1>;
            timeout-ms = <300>;
        };

        compatible = "zmk,combos";

        combo_ng_on {
            timeout-ms = <300>;
            key-positions = <23 37>; // H, Jのキー位置に書き換えてください
            bindings = <&ng_on>;
            layers = <0>; // デフォルトレイヤーが0の前提
        };

        combo_ng_off {
            timeout-ms = <300>;
            key-positions = <17 32>; // F, Gのキー位置に書き換えてください
            bindings = <&ng_off>;
            layers = <1>; // デフォルトレイヤーが0、薙刀式レイヤーが1の前提
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Layer_0 {
            display-name = "Mac";
            bindings = <
&mt_impl LALT ESCAPE       &kp Q             &kp W                &kp E                    &kp R             &kp T                                   &kp UP                &kp Y                 &kp U             &kp I             &kp O                &kp P                  &kp SINGLE_QUOTE
&mt_impl LEFT_CONTROL TAB  &mt LEFT_SHIFT A  &mt_impl LEFT_ALT S  &mt_impl LEFT_CONTROL D  &mt_impl LGUI F   &kp G                         &kp LEFT  &kp ENTER  &kp RIGHT  &kp H                 &mt_impl LGUI J   &mt_impl LCTRL K  &mt_impl LEFT_ALT L  &mt_impl LSHIFT MINUS  &kp SEMI
&td0                       &kp Z             &kp X                &kp C                    &kp V             &kp B           &kp K_MUTE              &kp DOWN              &kp N                 &kp M             &kp COMMA         &kp DOT              &kp FSLH               &kp EQUAL
                                                                  &kp LGUI                 &lt_impl 4 SPACE  &lt_impl 2 DEL                                                &lt_impl 3 BACKSPACE  &lt_impl 4 ENTER  &ng_on
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            label = "Mac";
        };

        layer_1 {
            display-name = "Naginata";
            bindings = <
&mt_impl LALT ESCAPE       &ng Q  &ng W  &ng E    &ng R      &ng T                                   &kp UP                &ng Y                 &ng U             &ng I      &ng O    &ng P     &kp DOUBLE_QUOTES
&mt_impl LEFT_CONTROL TAB  &ng A  &ng S  &ng D    &ng F      &ng G                         &kp LEFT  &kp ENTER  &kp RIGHT  &ng H                 &ng J             &ng K      &ng L    &ng SEMI  &kp EXCL
&td0                       &ng Z  &ng X  &ng C    &ng V      &ng B           &kp K_MUTE              &kp DOWN              &ng N                 &ng M             &ng COMMA  &ng DOT  &ng FSLH  &kp QUESTION
                                         &ng_off  &ng SPACE  &lt_impl 2 DEL                                                &lt_impl 3 BACKSPACE  &lt_impl 4 ENTER  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            label = "Naginata";
        };

        Layer_2 {
            bindings = <
&kp ESCAPE  &kp LPAR  &kp RPAR           &kp GRAVE         &kp TILDE          &kp AMPERSAND                              &kp LC(UP_ARROW)                   &kp KP_MULTIPLY  &kp N7  &kp N8   &kp N9  &kp KP_PLUS   &kp PERCENT
&none       &kp LBKT  &kp RIGHT_BRACKET  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp GRAVE                    &kp LC(LEFT)  &kp LC(P)           &kp LC(RIGHT)  &kp KP_DIVIDE    &kp N4  &kp N5   &kp N6  &kp KP_MINUS  &kp BACKSLASH
&none       &kp LBRC  &kp RIGHT_BRACE    &kp BACKSLASH     &kp PIPE           &none          &kp LG(N0)                  &kp LC(DOWN_ARROW)                 &kp EQUAL        &kp N1  &kp N2   &kp N3  &kp KP_ENTER  &kp DOLLAR
                                         &none             &kp LSHFT          &none                                                                         &kp ENTER        &kp N0  &kp DOT
            >;

            label = "Number";
            sensor-bindings = <&inc_dec_kp LG(PLUS) LG(MINUS)>;
        };

        Layer_3 {
            bindings = <
&none  &kp LS(LC(LG(Q)))  &kp LC(LS(W))  &kp LS(LC(E))  &none  &none                  &none         &none                 &none                 &none           &none                     &none                     &none
&none  &kp LS(LC(A))      &kp LS(LC(S))  &kp LS(LC(D))  &none  &none           &none  &none  &none  &none                 &kp LG(N1)            &kp LC(U)       &kp F4                    &none                     &none
&none  &kp LS(LC(Z))      &kp LS(LC(X))  &kp LS(LC(V))  &none  &none  &none           &none         &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LS(LG(N5))  &kp LS(LC(LG(NUMBER_3)))  &kp LS(LG(LC(NUMBER_4)))  &kp LS(LG(NUMBER_2))
                                         &none          &none  &none                                &none                 &kp LEFT_SHIFT        &kp LGUI
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PG_UP>;
            label = "Tiling";
        };

        Layer_4 {
            bindings = <
&none  &none      &none           &kp UP_ARROW    &kp PAGE_UP    &none                      &none         &kp LG(LC(F))  &kp LC(UP_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(P)  &none  &none
&none  &kp LC(A)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT      &kp LC(E)           &none  &none  &none  &kp LG(LA(S))  &kp LC(LEFT)      &kp LC(RIGHT)       &none      &none  &none
&none  &none      &none           &none           &kp PAGE_DOWN  &none      &none           &none         &kp LA(LS(N))  &kp LG(LS(TAB))   &kp LG(LS(SPACE))   &none      &none  &kp LS(NUMBER_2)
                                  &none           &none          &none                                    &none          &none             &none
            >;

            sensor-bindings = <&inc_dec_kp SPACE LS(SPACE)>;
            label = "Nav";
        };

        layer_5 {
            bindings = <
&to 0  &none      &none      &kp LG(R)        &kp LG(LS(R))  &kp LG(J)                                      &kp UP_ARROW               &none  &none  &none          &none           &none  &kp LG(NUMBER_0)
&none  &none      &none      &kp LC(LS(TAB))  &kp LC(TAB)    &kp LS(LG(BACKSLASH))                &kp LEFT  &kp ENTER       &kp RIGHT  &none  &none  &none          &none           &none  &kp LG(MINUS)
&none  &kp LG(Z)  &kp LG(W)  &kp LG(C)        &kp LG(V)      &none                  &kp K_MUTE              &kp DOWN_ARROW             &none  &none  &kp LS(COMMA)  &kp LS(PERIOD)  &none  &kp LG(PLUS)
                             &kp LGUI         &kp LS(SPACE)  &kp SPACE                                                                 &none  &none  &none
            >;

            label = "Browse";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_6 {
            bindings = <
&to 0  &none  &kp LG(LC(T))  &kp LG(LC(A))             &kp LC(LG(S))         &kp LC(LG(G))                             &kp LG(LEFT)              &none            &none              &none       &none  &none  &none
&none  &none  &none          &kp LG(LC(P))             &kp LG(LC(F))         &kp LG(S)                       &kp LEFT  &none          &kp RIGHT  &none            &none              &none       &none  &none  &none
&none  &none  &none          &kp LS(LG(LEFT_BRACKET))  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &none              &kp LG(RIGHT)             &none            &none              &none       &none  &none  &none
                             &none                     &kp SPACE             &none                                                               &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_MUTE
            >;

            label = "Media";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        Layer_7 {
            bindings = <
&to 0  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                         &none         &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &none            &none  &none
&none  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                 &none  &none  &none  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &none  &none
&none  &bt BT_CLR     &none          &none          &none          &none          &bootloader           &none         &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &none  &none
                                     &bt BT_PRV     &bt BT_NXT     &none                                              &none            &none            &none
            >;

            sensor-bindings = <&rgb_encoder>;
            label = "Settings";
        };

        Fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans   &trans   &trans                                     &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
